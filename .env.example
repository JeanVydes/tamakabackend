# Variables de docker-compose.yml (raiz del repositorio). Copie este archivo a .env
# o ejecute ./infra/generar-secretos.sh, que lo crea con valores aleatorios.
# Nunca versione el .env: contiene secretos.

# --- PostgreSQL ---
# Superusuario (solo para inicializar esquemas).
POSTGRES_ADMIN_PASSWORD=
# Clave de los usuarios tamaka_<servicio> (uno por esquema).
TAMAKA_DB_PASSWORD=

# --- JWT RS256 (Base64 del DER, sin cabeceras PEM; una sola linea) ---
# Clave publica X.509/SPKI: la usan los 10 servicios para validar.
TAMAKA_JWT_PUBLIC_KEY=
# Clave privada PKCS#8: solo Cuentas, para firmar.
TAMAKA_JWT_PRIVATE_KEY=

# --- Bus de eventos ---
# Secreto compartido de /internal/eventos. Vacio = los eventos quedan PENDIENTE en el outbox.
TAMAKA_EVENTOS_SECRETO=

# --- Pagos ---
# Secreto HMAC de la pasarela. Vacio = todos los webhooks se rechazan.
PAGOS_WEBHOOK_SECRET=
# Mock/sandbox: true = aprobacion instantanea al iniciar el pago (sin urlPago ni webhook).
# false al integrar una pasarela real.
TAMAKA_PAGOS_APROBACION_AUTOMATICA=true

# --- Despliegue ---
# Puerto publico del gateway.
TAMAKA_HTTP_PORT=80
# Limite de memoria por microservicio (10 JVM: con 384m conviene una VM de 4 GB o mas).
TAMAKA_MEMORIA_SERVICIO=384m
# Opciones de la JVM (por defecto: JIT C1, code cache y pila reducidos; ver README "Despliegue").
# TAMAKA_JAVA_OPTS=-XX:MaxRAMPercentage=65 -XX:+UseSerialGC -XX:TieredStopAtLevel=1 -XX:ReservedCodeCacheSize=48m -XX:+ExitOnOutOfMemoryError -Xss512k -Dfile.encoding=UTF-8
# --- Cloudflare R2 (bucket público de imágenes, compatible con S3) ---
# Las imágenes de ofertas (atractivos, comercios/servicios, eventos) y el foto de perfil se guardan aquí.
# Configurados en la máquina; el compose los inyecta como TAMAKA_STORAGE_*.
# Vacío = subida deshabilitada (503); el resto del API funciona igual.
R2_S3_API=https://<account-id>.r2.cloudflarestorage.com/<bucket>
R2_BUCKET_NAME=
R2_DOMAIN=cdn.example.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
